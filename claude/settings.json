{
  "cleanupPeriodDays": 365,
  "env": {},
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_navigate_back",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_network_requests",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_close",
      "mcp__playwright__browser_install",
      "mcp__playwright__browser_tabs",
      "mcp__plugin_playwright_playwright__browser_navigate",
      "mcp__plugin_playwright_playwright__browser_navigate_back",
      "mcp__plugin_playwright_playwright__browser_snapshot",
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "mcp__plugin_playwright_playwright__browser_console_messages",
      "mcp__plugin_playwright_playwright__browser_network_requests",
      "mcp__plugin_playwright_playwright__browser_resize",
      "mcp__plugin_playwright_playwright__browser_wait_for",
      "mcp__plugin_playwright_playwright__browser_close",
      "mcp__plugin_playwright_playwright__browser_install",
      "mcp__plugin_playwright_playwright__browser_tabs",
      "mcp__pencil"
    ],
    "deny": [
      "Bash(git reset --hard *)",
      "Bash(git checkout . *)",
      "Bash(git clean *)",
      "Bash(git push --force *)",
      "Bash(sudo *)"
    ],
    "ask": [
      "mcp__plugin_supabase_supabase__execute_sql",
      "mcp__plugin_supabase_supabase__apply_migration",
      "Bash(psql *)",
      "Bash(supabase db *)",
      "Bash(npx supabase db *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-opus-4-8[1m]",
  "availableModels": [
    "claude-opus-4-8[1m]",
    "claude-opus-4-8",
    "opus",
    "sonnet",
    "haiku",
    "fable"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "py ~/.claude/hooks/pretooluse_bash.py"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_supabase_supabase__execute_sql|mcp__plugin_supabase_supabase__apply_migration",
        "hooks": [
          {
            "type": "command",
            "command": "py ~/.claude/hooks/pretooluse_db_mcp.py"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "py ~/.claude/hooks/pretooluse_code.py"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "py ~/.claude/hooks/pretooluse_code.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "py ~/.claude/hooks/posttooluse_write.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "py ~/.claude/hooks/userpromptsubmit_pushsql.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/sessionstart_resource_check.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "py ~/.ai-instructions/tools/wip_autosave.py --here --apply",
            "timeout": 300,
            "statusMessage": "Saving work in progress..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"$HOME/.claude/notifications/notify-custom.ps1\" notification claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/stop_repo_checks.sh"
          },
          {
            "type": "command",
            "command": "py ~/.claude/hooks/stop_cleanup_playwright_screenshots.py"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"$HOME/.claude/notifications/notify-custom.ps1\" stop claude"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "greptile@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "postman@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": true,
    "brightdata-plugin@claude-plugins-official": true,
    "chrome-devtools-mcp@chrome-devtools-plugins": false,
    "resend@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "effortLevel": "medium"
}
